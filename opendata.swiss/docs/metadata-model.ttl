# =============================================================================
# 7. ORGANIZATIONS
# -----------------------------------------------------------------------------
# Typed as both org:Organization and foaf:Organization. Versioned in the
# repository under metadata/piveau_organizations/. The hierarchy is flattened
# into the search index as hierarchy_level + ancestors; in RDF it is expressed
# purely through org:subOrganizationOf.
#
# Production uses exactly: dct:identifier, foaf:name, skos:prefLabel,
# dct:description, org:classification, org:subOrganizationOf, foaf:homepage.
# The shape additionally allows foaf:mbox ("email") and the systemtest fixtures
# carry schema:image, but neither occurs on any organization in production.
# =============================================================================

# Level 0 — the top-level publisher
<https://opendata.swiss/id/organization/ch1>
    a                    org:Organization , foaf:Organization ;
    dct:identifier       "ch1" ;
    foaf:name            "Schweizerische Eidgenossenschaft"@de ,
                         "Confédération suisse"@fr ,
                         "Confederazione Svizzera"@it ,
                         "Swiss Confederation"@en ;
    skos:prefLabel       "Bund"@de , "Confédération"@fr , "Confederazione"@it , "Confederation"@en ;
    dct:description      "Bundesverwaltung der Schweizerischen Eidgenossenschaft."@de ,
                         "Federal administration of the Swiss Confederation."@en ;
    org:classification   <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage        <https://www.admin.ch/> .
    # foaf:mbox / schema:image: shape-allowed, unused in production.

# Level 1 — sub-organization
<https://opendata.swiss/id/organization/bundesamt-fur-statistik-bfs>
    a                    org:Organization , foaf:Organization ;
    dct:identifier       "bundesamt-fur-statistik-bfs" ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch1> ;
    org:classification   <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:name            "Bundesamt für Statistik BFS"@de ,
                         "Office fédéral de la statistique OFS"@fr ,
                         "Ufficio federale di statistica UST"@it ,
                         "Federal Statistical Office FSO"@en ;
    skos:prefLabel       "BFS"@de , "OFS"@fr , "UST"@it , "FSO"@en ;
    dct:description      "Nationales Kompetenzzentrum der öffentlichen Statistik der Schweiz."@de ;
    foaf:homepage        <https://www.bfs.admin.ch/> .

# Level 2 — cantonal example, showing that the hierarchy is not federal-only
<https://opendata.swiss/id/organization/staatskanzlei-kanton-zuerich>
    a                    org:Organization , foaf:Organization ;
    dct:identifier       "staatskanzlei-kanton-zuerich" ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/kanton-zuerich> ;
    org:classification   <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:name            "Staatskanzlei Kanton Zürich"@de ;
    skos:prefLabel       "Staatskanzlei ZH"@de ;
    dct:description      "Die Staatskanzlei des Kantons Zürich unterstützt den Regierungsrat."@de ;
    foaf:homepage        <https://www.zh.ch/de/staatskanzlei.html> .

<https://opendata.swiss/id/organization/kanton-zuerich>
    a                    org:Organization , foaf:Organization ;
    dct:identifier       "kanton-zuerich" ;
    org:classification   <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:name            "Kanton Zürich"@de , "Canton of Zurich"@en ;
    skos:prefLabel       "Kanton Zürich"@de ;
    dct:description      "Der Kanton Zürich veröffentlicht offene Behördendaten."@de ;
    foaf:homepage        <https://www.zh.ch/opendata> .

# foaf:homepage values are typed as foaf:Document in the organization files.
<https://www.admin.ch/>                      a foaf:Document .
<https://www.bfs.admin.ch/>                  a foaf:Document .
<https://www.zh.ch/opendata>                 a foaf:Document .
<https://www.zh.ch/de/staatskanzlei.html>    a foaf:Document .


# =============================================================================
# 8. SHOWCASE
# -----------------------------------------------------------------------------
# ODSn-only resource type; does not exist in the piveau standard. Authored in
# the UI, pulled in by piveau-consus-importing-showcases, then rewritten by the
# patching module before storage:
#   - the `dcat:Dataset` cloak type the source emits is REMOVED
#     ("remove-dataset-cloak")
#   - the source type http://localhost:3000/Showcase becomes
#     https://example.org/Showcase
#   - dct:references blank nodes are UNWRAPPED to the plain dataset IRI
#     they carried in dct:identifier ("unwrap-references")
# What is shown below is the post-patch state, i.e. what is in the triplestore.
# =============================================================================

# IRI pattern verified in production: …/set/resource/showcase/{slug}.
<https://opendata.swiss/set/resource/showcase/mietpreisentwicklung-in-bern>
    a                    ex:Showcase , pv:CustomResource ;
    dct:identifier       "mietpreisentwicklung-in-bern" ;
    dct:type             <https://opendata.swiss/vocabulary/showcase-type/application> ;

    # The showcase shape requires all four national languages on dct:title.
    dct:title            "Mietpreisentwicklung in Bern"@de ,
                         "Évolution des loyers à Berne"@fr ,
                         "Andamento degli affitti a Berna"@it ,
                         "Rent price development in Bern"@en ;
    dct:abstract         "Dieses interaktive Dashboard zeigt die Entwicklung der Mietpreise."@de ,
                         "Ce tableau de bord interactif montre l'évolution des loyers."@fr ;
    schema:text          "Ausführliche Beschreibung der Anwendung, als Fliesstext im CMS erfasst."@de ,
                         "Description détaillée de l'application."@fr ;
    # A literal URL string in production (sometimes a relative CMS path like
    # "/cms/92.png"), NOT an IRI node.
    schema:image         "https://opendata.swiss/images/showcase/mietpreisentwicklung.jpg" ;

    dcat:theme           <http://publications.europa.eu/resource/authority/data-theme/SOCI> ;
    dcat:keyword         "bern"@de , "mietpreise"@de ;

    # Post-unwrap: a direct IRI reference to the dataset the showcase uses.
    dct:references       <https://opendata.swiss/set/data/arbeitswegzeit-und-arbeitswegdistanz-bundesamt-fur-statistik-bfs> ;

    # piveau-internal flag driving the "featured" slot in the UI; on every
    # showcase in production, not declared in the SHACL shape.
    pv:pinned            false ;

    dct:issued           "2026-02-11T08:00:00Z"^^xsd:dateTime ;
    dct:modified         "2026-05-03T14:22:00Z"^^xsd:dateTime .

    # Allowed by the showcase shape but not used by any showcase in production:
    #   dcat:landingPage ("website"), dcat:contactPoint ("publisher"),
    #   schema:ratingValue ("rating").


