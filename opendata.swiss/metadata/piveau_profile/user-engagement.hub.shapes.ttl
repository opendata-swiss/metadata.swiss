@prefix ex: <https://example.org/> .
@prefix pv: <https://piveau.eu/ns/voc#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:UserEngagement a rdfs:Class .

ex:UserEngagement_Shape a sh:NodeShape ;
    sh:targetClass ex:UserEngagement ;
    sh:name "User engagement"@en ;
    sh:property [
          sh:maxCount 1 ;
          pv:mappingClass "StandardText" ;
          pv:mappingName "id"
      ], [
          sh:path pv:hasParent ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:nodeKind sh:IRI ;
          pv:mappingClass "StandardResourceKeyword" ;
          pv:mappingName "showcase_id"
      ], [
          sh:path schema:ratingValue ;
          sh:maxCount 1 ;
          sh:nodeKind sh:Literal ;
          sh:datatype xsd:decimal ;
          sh:minInclusive 1 ;
          sh:maxInclusive 5 ;
          pv:mappingClass "Numeric" ;
          pv:mappingName "average_rating"
      ], [
          sh:path pv:favoritedBy ;
          sh:nodeKind sh:IRI ;
          pv:mappingClass "StandardResourceKeyword" ;
          pv:mappingName "favorite_users"
      ] .
