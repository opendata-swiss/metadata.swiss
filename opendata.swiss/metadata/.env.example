# Used in the Docker Compose stack
## Secrets
ELASTIC_PASSWORD="elastic-password"
PIVEAU_HUB_API_KEY="secret-hub-api-key"
PIVEAU_HUB_SEARCH_API_KEY="secret-search-api-key" # Don't forget to update it in PIVEAU_HUB_SEARCH_SERVICE too!
PIVEAU_METRICS_CACHE_API_KEY="secret-metrics-cache-api-key"

PIVEAU_HUB_AUTHORIZATION_PROCESS_DATA='{}'
PIVEAU_HUB_SEARCH_SERVICE='{"enabled":true,"url":"piveau-hub-search","port":8080,"api_key":"secret-search-api-key"}'
PIVEAU_HUB_SEARCH_ES_CONFIG='{
  "host": "elasticsearch",
  "port": 9200,
  "user": "elastic",
  "password": "elastic-password",
  "vocabulary": {
    "ch-licenses": {
      "fields": [
        "license"
      ],
      "replacements": [
        "label:pref_label.en",
        "resource:resource"
      ]
    },
    "showcase-types": {
      "documentTypes": [
        "resource_showcase"
      ],
      "fields": [
        "type"
      ],
      "replacements": [
        "id:id",
        "label:pref_label",
        "resource:resource"
      ]
    },
    "legal-forms": {
        "documentTypes": [
            "organization"
        ],
        "fields": [
            "classification"
        ],
        "replacements": [
            "id:id",
            "label:pref_label",
            "resource:resource"
        ]
    }
  },
  "index": {
    "dataset": {
      "facets" : [ {
        "name" : "dataScope",
        "title" : "Data scope",
        "path" : "country",
        "type" : "nested",
        "facets" : [ {
          "name" : "eu",
          "title" : "European Union Data",
          "path" : "country",
          "type" : "mustNotMatch",
          "match" : false,
          "values" : [ "eu" ]
        }, {
          "name" : "io",
          "title" : "International Data",
          "path" : "country",
          "type" : "mustNotMatch",
          "match" : false,
          "values" : [ "io" ]
        }, {
          "name" : "countryData",
          "title" : "National Data",
          "path" : "country",
          "type" : "mustNotMatch",
          "match" : true,
          "values" : [ "eu", "io" ]
        } ]
      }, {
        "name" : "is_hvd",
        "title" : "HVD",
        "path" : "is_hvd",
        "plain" : true
      }, {
        "name" : "hvdCategory",
        "title" : "HVD Category",
        "path" : "hvd_category"
      }, {
        "name" : "country",
        "title" : "Provenance",
        "path" : "country"
      }, {
        "name" : "catalog",
        "title" : "Catalogues",
        "path" : "catalog"
      }, {
        "name" : "superCatalog",
        "title" : "Super Catalogues",
        "path" : "catalog.is_part_of",
        "plain" : true
      }, {
        "name" : "categories",
        "title" : "Categories",
        "path" : "categories"
      }, {
        "name" : "publisher",
        "title" : "Publisher",
        "path" : "publisher",
        "aggregation_term" : "name.raw"
      }, {
        "name" : "keywords",
        "title" : "Keywords",
        "path" : "keywords"
      }, {
        "name" : "scoring",
        "title" : "Scoring",
        "type" : "nested",
        "facets" : [ {
          "name" : "excellentScoring",
          "title" : "Excellent Scoring",
          "path" : "quality_meas.scoring",
          "type" : "range",
          "from" : 351,
          "to" : 406
        }, {
          "name" : "goodScoring",
          "title" : "Good Scoring",
          "path" : "quality_meas.scoring",
          "type" : "range",
          "from" : 221,
          "to" : 351
        }, {
          "name" : "sufficientScoring",
          "title" : "Sufficient Scoring",
          "path" : "quality_meas.scoring",
          "type" : "range",
          "from" : 121,
          "to" : 221
        }, {
          "name" : "badScoring",
          "title" : "Bad Scoring",
          "path" : "quality_meas.scoring",
          "type" : "range",
          "from" : 0,
          "to" : 121
        } ]
      }, {
        "name" : "format",
        "title" : "Formats",
        "path" : "distributions.format"
      }, {
        "name" : "license",
        "title" : "Licenses",
        "path" : "distributions.license"
      }, {
        "name" : "subject",
        "title" : "Subject",
        "path" : "subject"
      }, {
        "name" : "language",
        "title" : "Language",
        "path" : "language"
      }, {
        "name" : "conformance",
        "title" : "Conformance",
        "path" : "conforms_to",
        "aggregation_term" : "label.raw"
      }, {
        "name" : "accessRight",
        "title" : "Access Right",
        "path" : "access_right",
        "aggregation_term" : "label.raw"
      }, {
        "name" : "contactPoint",
        "title" : "Contact Point",
        "path" : "contact_point",
        "aggregation_term" : "name.raw"
      }, {
        "name" : "type",
        "title" : "Type",
        "path" : "type"
      }, {
        "name": "organization",
        "title": "Organization",
        "path": "catalog.publisher_id",
        "aggregation_term": "raw",
        "fromIndex": "organization",
        "fromIndexField": "id",
        "display_title": "name"
      } ]
    },
    "organization": {
      "facets": [
        {
          "name": "classification",
          "title": "Classification",
          "path": "classification"
        }
      ]
    }
  }
}'

## Features configuration
PIVEAU_FEATURE_FLAGS='{ "piveau_profile": true }'
PIVEAU_PROFILE='{ "type": "directory", "path": "/piv-profile" }'

## Only for the hub-ui
VITE_AUTHENTICATION_KEYCLOAK_REALM="vanilla"
VITE_AUTHENTICATION_KEYCLOAK_URL="https://demo.piveau.io/auth"
VITE_AUTHENTICATION_KEYCLOAK_CLIENT_ID="piveau-hub-ui"

# Only used in the scripts
HUB_REPO_ENDPOINT="http://localhost:8081"
CONSUS_SCHEDULING_ENDPOINT="http://localhost:8090"
PIVEAU_METRICS_CACHE_ENDPOINT="http://localhost:8185"

LISTMONK_ADMIN_USER="admin"
LISTMONK_ADMIN_PASSWORD="password"
LISTMONK_ADMIN_API_USER="admin-api"

# Mailpit
MAILPIT_WEB_URL="http://localhost:8025"
MAILPIT_SMTP_URL="smtp://localhost:1025"
