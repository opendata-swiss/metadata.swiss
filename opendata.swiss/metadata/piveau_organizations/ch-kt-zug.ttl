"""@de ;
    dcterms:identifier "CH_KT_ZUG" ;
    skos:prefLabel "Kanton Zug"@de,
        "Canton of Zug"@en,
        "Canton de Zoug"@fr,
        "Cantone di Zugo"@it ;
