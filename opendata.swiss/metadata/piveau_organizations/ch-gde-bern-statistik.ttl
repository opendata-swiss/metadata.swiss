<https://opendata.swiss/id/organization/ch-gde-bern-statistik> a org:Organization,
        foaf:Organization ;
    dcterms:description "Statistik Stadt Bern stellt den politischen Behörden, der Verwaltung sowie der Öffentlichkeit statistische Informationen und Analysen über die Stadt Bern zur Verfügung. Der Bereich Statistik ist zuständig für die Durchführung statistischer Erhebungen in der Stadt Bern und für die Koordination der Statistik in der Stadtverwaltung."@de ;
    dcterms:identifier "CH_GDE_BERN_STATISTIK" ;
    skos:prefLabel "Statistik Stadt Bern"@de ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-gde-bern> ;
    foaf:homepage <https://www.bern.ch/politik-und-verwaltung/stadtverwaltung/prd/abteilung-aussenbeziehungen-und-statistik/statistik-stadt-bern> ;
    foaf:name "Statistik Stadt Bern"@de .

