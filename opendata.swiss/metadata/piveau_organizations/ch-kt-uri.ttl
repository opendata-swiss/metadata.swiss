@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://opendata.swiss/id/organization/ch-kt-uri> a org:Organization,
        foaf:Organization ;
    dcterms:description "Der Kanton Uri wird hier nach und nach Datensätze der kantonalen Verwaltung veröffentlichen, welche die Anforderungen zur Publikation als Open Government Data erfüllen."@de,
        "The canton of Uri will gradually publish datasets of the cantonal administration here that meet the requirements for publication as open government data."@en,
        "Le canton d'Uri publiera progressivement sur cette plateforme les ensembles de données de l'administration cantonale qui répondent aux exigences de publication en tant que Open Government Data."@fr,
        "Il Cantone de Uri pubblicherà gradualmente su questa piattaforma i dataset dell'amministrazione cantonale che soddisfano i requisiti per la pubblicazione come Open Government Data."@it ;
    dcterms:identifier "CH_KT_URI" ;
    skos:prefLabel "Kanton Uri"@de,
        "Canton d'Uri"@fr,
        "Cantone di Uri"@it ;
    foaf:homepage <https://www.ur.ch> ;
    foaf:name "Kanton Uri"@de,
        "Canton d'Uri"@fr,
        "Cantone di Uri"@it .

<https://www.ur.ch> a foaf:Document .

