@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://opendata.swiss/id/organization/ch-kt-luzern-finanzen> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Dienststelle Finanzen ist das Kompetenzzentrum der kantonalen Verwaltung für Finanz- und Controlling-Fragen. Sie sorgt dafür, dass die öffentlichen Gelder zuverlässig verwaltet werden. Sie organisiert das Rechnungswesen inklusive Betrieb des Buchungszentrums und stellt sicher, dass der Kanton Luzern jederzeit zahlungsfähig bleibt."@de,
        "The Finance Department is the cantonal administration's center of expertise for financial and controlling matters. It ensures the reliable management of public funds. It organizes the accounting system, including the operation of the accounting center, and ensures that the Canton of Lucerne remains solvent at all times."@en,
        "Le service des Finances est le centre d'expertise de l'administration cantonale en matière financière et de contrôle. Il garantit la gestion rigoureuse des fonds publics. Il organise le système comptable, notamment le fonctionnement du centre de comptabilité, et veille à la solvabilité du canton de Lucerne en toutes circonstances."@fr,
        "Il Dipartimento delle Finanze è il centro di competenza dell'amministrazione cantonale per le questioni finanziarie e di controllo. Assicura la gestione affidabile dei fondi pubblici, organizza il sistema contabile, compreso il funzionamento del centro contabile, e garantisce che il Cantone di Lucerna rimanga solvibile in ogni momento."@it ;
    dcterms:identifier "CH_KT_LUZERN_FINANZEN" ;
    skos:prefLabel "Finanzen (LU)"@de,
        "Finances (LU)"@en,
        "Finances (LU)"@fr,
        "Finanze (LU)"@it ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-luzern> ;
    foaf:homepage <https://finanzen.lu.ch> ;
    foaf:name "Dienststelle Finanzen (LU)"@de,
        "Finance Department (LU)"@en,
        "Service des Finances (LU)"@fr,
        "Dipartimento delle Finanze (LU)"@it .

<https://finanzen.lu.ch> a foaf:Document .

