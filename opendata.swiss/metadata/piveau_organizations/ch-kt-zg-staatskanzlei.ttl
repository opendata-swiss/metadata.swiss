"""@de ;
    dcterms:identifier "CH_KT_ZG_STAATSKANZLEI" ;
    skos:prefLabel "Staatskanzlei Zug"@de ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zug> ;
