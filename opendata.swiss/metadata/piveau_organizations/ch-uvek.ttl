    foaf:homepage <https://uvek.admin.ch> ;
    foaf:name "Eidgenössisches Departement für Umwelt, Verkehr, Energie und Kommunikation (UVEK)"@de,
        "Federals Departement für Umwelt, Verkehr, Energie und Kommunikation (UVEK)"@en,
        "Département fédéral de l'environnement, des transports, de l'énergie et de la communication (DETEC)"@fr,
