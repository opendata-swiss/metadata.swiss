@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://opendata.swiss/id/organization/ch-edu-psi> a org:Organization,
        foaf:Organization ;
    dcterms:description "Das PSI betreibt international anerkannte Spitzenforschung in Natur- und Ingenieurswissenschaften. Wissenschaftlerinnen und Wissenschaftler aus der ganzen Welt forschen an unseren Grossforschungsanlagen."@de,
        "PSI conducts internationally recognised cutting-edge research in the natural and engineering sciences. Scientists from all over the world carry out experiments at our large research facilities."@en,
        "Le PSI effectue de la recherche de pointe reconnue au niveau international dans les sciences naturelles et les sciences de l’ingénierie."@fr,
        "Il PSI conduce ricerche all'avanguardia, riconosciute a livello internazionale, nel campo delle scienze naturali e dell'ingegneria. Scienziati provenienti da tutto il mondo conducono ricerche presso le nostre strutture di ricerca su larga scala."@it ;
    dcterms:identifier "CH_EDU_PSI" ;
    skos:prefLabel "Paul Scherrer Institut PSI"@de,
        "Paul Scherrer Institute PSI"@en,
        "Institut Paul Scherrer PSI"@fr,
        "Istituto Paul Scherrer PSI"@it ;
    foaf:homepage <https://www.psi.ch> ;
    foaf:name "Paul Scherrer Institut PSI"@de,
        "Paul Scherrer Institute PSI"@en,
        "Institut Paul Scherrer PSI"@fr,
        "Istituto Paul Scherrer PSI"@it .

<https://www.psi.ch> a foaf:Document .

