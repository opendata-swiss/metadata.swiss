    foaf:name "Information Service Center WBF (ISCeco)"@de,
        "Information Service Center WBF (ISCeco)"@en,
        "Centre de services informatiques du DEFR (ISCeco)"@fr,
        "Centro servizi informatici DEFR (ISCeco)"@it .

