        skos:inScheme   <http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole>;
        skos:prefLabel  "Resource Provider"@en , "Fournisseur de la ressource"@fr , "Ressourcenanbieter"@de , "Fornitore della risorsa"@it .

<http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/originator>
