        skos:inScheme   <http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole>;
        skos:prefLabel  "Distributor"@en , "Distributeur"@fr , "Vertrieb"@de , "Distributore"@it .

<http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/pointOfContact>
