<http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/user>
        rdf:type        skos:Concept;
        skos:inScheme   <http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole>;
        skos:prefLabel  "Utilisateur"@fr , "User"@en , "Nutzer"@de , "Utente"@it .

<http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider>
