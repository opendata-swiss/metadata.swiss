@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://opendata.swiss/vocabulary/showcase-type/> .

<https://opendata.swiss/vocabulary/showcase-types>
    a owl:Ontology, skos:ConceptScheme ;
    skos:prefLabel
        "Showcase Types"@en,
        "Types de vitrine"@fr,
        "Showcase-Typen"@de,
        "Tipi di vetrina"@it .

<application>
    a skos:Concept ;
    skos:inScheme <https://opendata.swiss/vocabulary/showcase-types> ;
    skos:prefLabel
        "Application"@en ,
        "Application"@fr ,
        "Applikation"@de ,
        "Applicazione"@it .

<data_visualization>
    a skos:Concept ;
    skos:inScheme <https://opendata.swiss/vocabulary/showcase-types> ;
    skos:prefLabel
        "Data Visualization"@en ,
        "Visualisation des données"@fr ,
        "Daten-Visualisierung"@de ,
        "Visualizzazione dei dati"@it .

<event>
    a skos:Concept ;
    skos:inScheme <https://opendata.swiss/vocabulary/showcase-types> ;
    skos:prefLabel
        "Event"@en ,
        "Événement"@fr ,
        "Veranstaltung"@de ,
        "Evento"@it .

<blog_media>
    a skos:Concept ;
    skos:inScheme <https://opendata.swiss/vocabulary/showcase-types> ;
    skos:prefLabel
        "Blog and media"@en ,
        "Blog et média"@fr ,
        "Blog und Medienartikel"@de ,
        "Blog e media"@it .

<article>
    a skos:Concept ;
    skos:inScheme <https://opendata.swiss/vocabulary/showcase-types> ;
    skos:prefLabel
        "Scientific article"@en ,
        "Article scientifique"@fr ,
        "Wissenschaftliche Arbeit"@de ,
        "Articolo scientifico"@it .
